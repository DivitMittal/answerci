{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://answerci.dev/schemas/prompt-suite.schema.json",
  "title": "AnswerCI PromptSuite",
  "type": "object",
  "required": [
    "name",
    "target",
    "prompts"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "$ref": "#/$defs/entity"
    },
    "competitors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "default": []
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/prompt"
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}